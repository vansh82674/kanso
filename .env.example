# -----------------------------------------------------------------------------
# Supabase PostgreSQL & Next.js Environment Configuration
# -----------------------------------------------------------------------------

# 1. DATABASE_URL: Supabase PgBouncer / Supavisor Connection Pooler (Port 6543)
# Used by runtime route handlers, queries, and mutations in transaction mode.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct PostgreSQL Connection (Port 5432)
# Required by Prisma CLI for migrations (migrate dev, db push) and schema introspection.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 3. Next.js Public Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
